{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:base"],
  "updateInternalDeps": true,
  "rangeStrategy": "bump",
  "automerge": true,
  "automergeType": "pr",
  "platformAutomerge": true,
  "automergeStrategy": "squash",
  "packageRules": [
    {
      "description": "Keep security overrides within their selected major version",
      "matchDepTypes": ["pnpm.overrides", "pnpm-workspace.overrides"],
      "matchUpdateTypes": ["major"],
      "enabled": false
    }
  ],
  "npm": {
    "fileMatch": ["(^|/)package\\.json$", "(^|/)package\\.json\\.hbs$"]
  }
}
