{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:base"],
  "updateInternalDeps": true,
  "rangeStrategy": "bump",
  "automerge": true,
  "automergeType": "pr",
  "platformAutomerge": true,
  "automergeStrategy": "squash",
  "packageRules": [
    {
      "description": "Match Bun's 24-hour release age for npm updates",
      "matchManagers": ["bun"],
      "matchDatasources": ["npm"],
      "minimumReleaseAge": "1 day",
      "minimumReleaseAgeBuffer": null
    },
    {
      "description": "Keep security overrides within their selected major version",
      "matchDepTypes": ["overrides"],
      "matchUpdateTypes": ["major"],
      "enabled": false
    }
  ],
  "npm": {
    "fileMatch": ["(^|/)package\\.json$", "(^|/)package\\.json\\.hbs$"]
  }
}
