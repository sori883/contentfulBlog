{
  "name": "contentfulblog",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "vite build --mode client && vite build",
    "preview": "pnpm run build && wrangler dev",
    "deploy:worker": "pnpm run build && wrangler deploy",
    "clean": "rm -rf dist/ node_modules/",
    "lint": "eslint .",
    "lint:text": "textlint contents/**/*.mdx --config .textlintrc.json",
    "lint:textfix": "textlint --fix contents/**/*.mdx --config .textlintrc.json",
    "format": "prettier --check \"**/*.{ts,tsx}\" --cache",
    "format:fix": "prettier --write \"**/*.{ts,tsx}\" --cache",
    "test:e2e": "pnpm build && playwright test",
    "typecheck": "tsc --noEmit"
  },
  "private": true,
  "engines": {
    "node": ">=24.20.0"
  },
  "packageManager": "pnpm@10.34.5",
  "dependencies": {
    "feed": "^6.0.0",
    "hono": "^4.13.3",
    "honox": "^0.1.61",
    "jsdom": "^30.0.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260905.1",
    "@eslint/js": "^9.39.5",
    "@formkit/tempo": "^1.1.0",
    "@hono/eslint-config": "^2.1.1",
    "@hono/vite-build": "^1.11.1",
    "@hono/vite-dev-server": "^0.26.1",
    "@hono/vite-ssg": "^0.3.3",
    "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
    "@mdx-js/rollup": "^3.1.1",
    "@tailwindcss/vite": "^4.3.3",
    "@textlint-ja/textlint-rule-preset-ai-writing": "^1.7.0",
    "@textlint/textlint-plugin-markdown": "^15.8.0",
    "@twemoji/parser": "^16.0.0",
    "@types/jsdom": "^30.0.0",
    "@types/mdx": "^2.0.14",
    "@types/node": "^24.13.3",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "miniflare": "5.20260811.1-alpha",
    "playwright": "^1.63.0",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "recma-export-filepath": "^1.2.0",
    "rehype-highlight": "^7.0.2",
    "rehype-mdx-code-props": "^3.0.1",
    "rehype-mdx-import-media": "^1.4.0",
    "rehype-mermaid": "^3.0.0",
    "rehype-slug": "^6.0.0",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.1",
    "remark-mdx-frontmatter": "^5.2.0",
    "tailwindcss": "^4.3.3",
    "textlint": "^15.8.0",
    "textlint-rule-aws-service-name": "^1.14.0",
    "textlint-rule-ja-no-redundant-expression": "^4.0.1",
    "textlint-rule-ja-unnatural-alphabet": "^2.0.1",
    "textlint-rule-no-doubled-joshi": "^5.1.1",
    "textlint-rule-preset-ja-technical-writing": "^12.0.2",
    "typescript-eslint": "^8.67.0",
    "vite": "^6.4.3",
    "vite-plugin-static-copy": "^4.1.1",
    "wrangler": "^4.123.0"
  }
}
