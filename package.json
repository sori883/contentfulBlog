{
  "name": "contentfulblog",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "vite build --mode client && vite build",
    "preview": "bun run build && wrangler dev",
    "deploy:worker": "bun run build && wrangler deploy",
    "clean": "rm -rf dist/ node_modules/",
    "lint": "eslint .",
    "format": "prettier --check \"**/*.{ts,tsx}\" --cache",
    "format:fix": "prettier --write \"**/*.{ts,tsx}\" --cache",
    "test:e2e": "bun run test:content && bun run test:dev && bun run build && playwright test",
    "typecheck": "tsc --noEmit",
    "write:new": "node scripts/new-write.mjs",
    "test:content": "playwright test -c playwright.content.config.ts",
    "test:dev": "playwright test -c playwright.dev.config.ts"
  },
  "private": true,
  "engines": {
    "node": ">=24.22.3"
  },
  "packageManager": "bun@1.4.5",
  "dependencies": {
    "hono": "^4.13.16",
    "honox": "^0.1.63"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261123.1",
    "@eslint/js": "^10.0.1",
    "@hono/eslint-config": "^2.1.1",
    "@hono/vite-build": "^1.11.1",
    "@hono/vite-dev-server": "^0.26.1",
    "@hono/vite-ssg": "^0.3.3",
    "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
    "@tailwindcss/vite": "^4.3.5",
    "@twemoji/parser": "^16.0.0",
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^24.19.2",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "markdown-it": "^15.0.3",
    "miniflare": "5.20261006.2-beta",
    "playwright": "^1.65.1",
    "prettier": "^3.10.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.5",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8",
    "wrangler": "^4.166.0",
    "yaml": "^2.9.1"
  },
  "overrides": {
    "brace-expansion@>=1.0.0 <1.1.22": "^1.1.22",
    "brace-expansion@>=5.0.0 <5.0.13": "^5.0.13",
    "js-yaml@>=4.0.0 <4.3.2": "^4.3.2",
    "source-map-js@>=1.0.0 <1.2.2": "^1.2.2",
    "undici@>=7.0.0 <7.30.1": "^7.30.1",
    "@hono/node-server@>=1.19.10 <2.1.3": "^2.1.11",
    "minimatch@>=7.0.0 <11.0.1": "^11.0.9"
  }
}
