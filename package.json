{
  "name": "contentfulblog",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "vite build --mode client && vite build",
    "preview": "pnpm run build && wrangler dev",
    "deploy:worker": "pnpm run build && wrangler deploy",
    "clean": "rm -rf dist/ node_modules/",
    "lint": "eslint .",
    "format": "prettier --check \"**/*.{ts,tsx}\" --cache",
    "format:fix": "prettier --write \"**/*.{ts,tsx}\" --cache",
    "test:e2e": "pnpm test:content && pnpm test:dev && pnpm build && playwright test",
    "typecheck": "tsc --noEmit",
    "write:new": "node scripts/new-write.mjs",
    "test:content": "playwright test -c playwright.content.config.ts",
    "test:dev": "playwright test -c playwright.dev.config.ts"
  },
  "private": true,
  "engines": {
    "node": ">=24.20.0"
  },
  "packageManager": "pnpm@10.34.5",
  "dependencies": {
    "hono": "^4.13.7",
    "honox": "^0.1.61"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260905.1",
    "@eslint/js": "^10.0.1",
    "@hono/eslint-config": "^2.1.1",
    "@hono/vite-build": "^1.11.1",
    "@hono/vite-dev-server": "^0.26.1",
    "@hono/vite-ssg": "^0.3.3",
    "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
    "@tailwindcss/vite": "^4.3.3",
    "@twemoji/parser": "^16.0.0",
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^24.13.3",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "markdown-it": "^15.0.1",
    "miniflare": "5.20260811.1-alpha",
    "playwright": "^1.63.0",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.2",
    "wrangler": "^4.129.0",
    "yaml": "^2.9.0"
  }
}
